#!/usr/bin/env python3
"""Replay the latest OOB VLM request and profile network and SSE latency."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
from typing import Any
from urllib.parse import urlsplit


DEFAULT_DEVICE = os.environ.get("ANDROID_SERIAL") or "emulator-5556"
DEFAULT_PACKAGE = "cn.com.omnimind.bot.debug"
DEFAULT_MMKV_PATH = "files/mmkv/mmkv.default"
REQUEST_LOG_KEY = b"recent_ai_request_logs_v1"
CURL_STATS_MARKER = "__OOB_CURL_STATS__"


def find_adb() -> str:
    candidates = [
        Path.home() / "Library" / "Android" / "sdk" / "platform-tools" / "adb",
        Path.home() / "Android" / "Sdk" / "platform-tools" / "adb",
    ]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate)
    return "adb"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Replay the latest app-saved OOB VLM request and profile DNS/TCP/TLS/TTFT/SSE latency."
    )
    parser.add_argument("--device", default=DEFAULT_DEVICE)
    parser.add_argument("--adb", default=find_adb())
    parser.add_argument("--package", default=DEFAULT_PACKAGE)
    parser.add_argument("--mmkv-path", default=DEFAULT_MMKV_PATH)
    parser.add_argument("--api-key-env", default="DASHSCOPE_API_KEY")
    parser.add_argument("--model", default="", help="Select the latest saved request for this model.")
    parser.add_argument("--timeout", type=int, default=180)
    parser.add_argument("--app-result", type=Path, default=None)
    parser.add_argument("--output", type=Path, default=None)
    args = parser.parse_args(argv)
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    return args


def read_mmkv(args: argparse.Namespace) -> bytes:
    result = subprocess.run(
        [
            args.adb,
            "-s",
            args.device,
            "exec-out",
            "run-as",
            args.package,
            "cat",
            args.mmkv_path,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"Unable to read {args.mmkv_path} from {args.device}: "
            f"{result.stderr.decode('utf-8', errors='replace').strip()}"
        )
    return result.stdout


def decode_request_logs(raw: bytes) -> list[dict[str, Any]]:
    marker_index = raw.rfind(REQUEST_LOG_KEY)
    if marker_index < 0:
        raise RuntimeError("MMKV does not contain recent_ai_request_logs_v1")
    json_start = raw.find(b"[", marker_index + len(REQUEST_LOG_KEY))
    if json_start < 0:
        raise RuntimeError("Unable to locate AI request log JSON in MMKV")
    decoded = raw[json_start:].decode("utf-8", errors="ignore")
    payload, _ = json.JSONDecoder().raw_decode(decoded)
    if not isinstance(payload, list):
        raise RuntimeError("AI request log payload is not a list")
    return [entry for entry in payload if isinstance(entry, dict)]


def select_request(logs: list[dict[str, Any]], model: str) -> dict[str, Any]:
    candidates = [
        entry
        for entry in logs
        if entry.get("label") == "openai/chat.completions.stream"
        and isinstance(entry.get("requestJson"), str)
        and entry.get("requestJson")
        and (not model or entry.get("model") == model)
    ]
    if not candidates:
        suffix = f" for model {model}" if model else ""
        raise RuntimeError(f"No saved streaming VLM request found{suffix}")
    return max(candidates, key=lambda entry: int(entry.get("createdAt") or 0))


def request_shape(request: dict[str, Any], request_bytes: bytes) -> dict[str, Any]:
    text_chars = 0
    image_count = 0
    image_payload_chars = 0
    for message in request.get("messages") or []:
        if not isinstance(message, dict):
            continue
        content = message.get("content")
        if isinstance(content, str):
            text_chars += len(content)
            continue
        if not isinstance(content, list):
            continue
        for item in content:
            if not isinstance(item, dict):
                continue
            if item.get("type") == "text":
                text_chars += len(str(item.get("text") or ""))
            if item.get("type") == "image_url":
                image_count += 1
                image_url = item.get("image_url")
                if isinstance(image_url, dict):
                    image_payload_chars += len(str(image_url.get("url") or ""))
                else:
                    image_payload_chars += len(str(image_url or ""))
    return {
        "request_bytes": len(request_bytes),
        "message_count": len(request.get("messages") or []),
        "tool_count": len(request.get("tools") or []),
        "text_chars": text_chars,
        "image_count": image_count,
        "image_payload_chars": image_payload_chars,
    }


def elapsed_ms(started_at: float) -> float:
    return round((time.perf_counter() - started_at) * 1000.0, 3)


def first_delta_kind(payload: dict[str, Any]) -> str | None:
    choices = payload.get("choices")
    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
        return None
    delta = choices[0].get("delta")
    if not isinstance(delta, dict):
        return None
    for key in ("reasoning_content", "reasoning", "content", "tool_calls"):
        value = delta.get(key)
        if value not in (None, "", [], {}):
            return key
    return None


def to_ms(value: Any) -> float | None:
    if not isinstance(value, (int, float)):
        return None
    return round(float(value) * 1000.0, 3)


def curl_phase_metrics(stats: dict[str, Any]) -> dict[str, Any]:
    lookup = float(stats.get("time_namelookup") or 0.0)
    connect = float(stats.get("time_connect") or 0.0)
    app_connect = float(stats.get("time_appconnect") or 0.0)
    pretransfer = float(stats.get("time_pretransfer") or 0.0)
    starttransfer = float(stats.get("time_starttransfer") or 0.0)
    return {
        "dns_ms": round(lookup * 1000.0, 3),
        "tcp_connect_ms": round(max(connect - lookup, 0.0) * 1000.0, 3),
        "tls_handshake_ms": round(max(app_connect - connect, 0.0) * 1000.0, 3),
        "post_tls_upload_queue_ttft_ms": round(max(starttransfer - pretransfer, 0.0) * 1000.0, 3),
        "response_start_ms": to_ms(stats.get("time_starttransfer")),
        "total_ms": to_ms(stats.get("time_total")),
    }


def profile_request(
    *,
    url: str,
    api_key: str,
    request_bytes: bytes,
    timeout: int,
) -> tuple[dict[str, Any], int, str]:
    curl = shutil.which("curl")
    if not curl:
        raise RuntimeError("curl is required")
    write_out = f"\n{CURL_STATS_MARKER}%{{json}}\n"
    command = [
        curl,
        "--silent",
        "--show-error",
        "--no-buffer",
        "--max-time",
        str(timeout),
        "--request",
        "POST",
        url,
        "--header",
        "Content-Type: application/json",
        "--header",
        "Accept: text/event-stream",
        "--header",
        f"Authorization: Bearer {api_key}",
        "--data-binary",
        "@-",
        "--write-out",
        write_out,
    ]
    started_at = time.perf_counter()
    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    assert process.stdin is not None
    assert process.stdout is not None
    process.stdin.write(request_bytes)
    process.stdin.close()

    first_sse_ms: float | None = None
    first_delta_ms: float | None = None
    first_delta_type: str | None = None
    usage_ms: float | None = None
    done_ms: float | None = None
    chunk_count = 0
    usage: dict[str, Any] = {}
    curl_stats: dict[str, Any] = {}

    for raw_line in process.stdout:
        line = raw_line.decode("utf-8", errors="replace").strip()
        if not line:
            continue
        if line.startswith(CURL_STATS_MARKER):
            curl_stats = json.loads(line[len(CURL_STATS_MARKER):])
            continue
        if not line.startswith("data:"):
            continue
        event_ms = elapsed_ms(started_at)
        if first_sse_ms is None:
            first_sse_ms = event_ms
        data = line[5:].strip()
        if data == "[DONE]":
            done_ms = event_ms
            continue
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        chunk_count += 1
        delta_kind = first_delta_kind(event)
        if delta_kind and first_delta_ms is None:
            first_delta_ms = event_ms
            first_delta_type = delta_kind
        event_usage = event.get("usage")
        if isinstance(event_usage, dict) and event_usage:
            usage = event_usage
            usage_ms = event_ms

    stderr = process.stderr.read().decode("utf-8", errors="replace").strip() if process.stderr else ""
    return_code = process.wait()
    observed_total_ms = elapsed_ms(started_at)
    response_start_ms = to_ms(curl_stats.get("time_starttransfer"))
    stream_end_ms = done_ms or usage_ms or observed_total_ms
    result = {
        "network": {
            **curl_phase_metrics(curl_stats),
            "http_code": curl_stats.get("http_code"),
            "http_version": curl_stats.get("http_version"),
            "num_connects": curl_stats.get("num_connects"),
            "size_upload_bytes": curl_stats.get("size_upload"),
            "size_download_bytes": curl_stats.get("size_download"),
        },
        "stream": {
            "first_sse_ms": first_sse_ms,
            "response_start_to_first_sse_ms": (
                round(max(first_sse_ms - response_start_ms, 0.0), 3)
                if first_sse_ms is not None and response_start_ms is not None
                else None
            ),
            "first_delta_ms": first_delta_ms,
            "first_delta_type": first_delta_type,
            "usage_ms": usage_ms,
            "done_ms": done_ms,
            "generation_after_first_sse_ms": (
                round(max(stream_end_ms - first_sse_ms, 0.0), 3)
                if first_sse_ms is not None
                else None
            ),
            "chunk_count": chunk_count,
            "observed_total_ms": observed_total_ms,
        },
        "usage": usage,
    }
    return result, return_code, stderr


def load_app_result(path: Path | None) -> dict[str, Any] | None:
    if path is None:
        return None
    payload = json.loads(path.read_text(encoding="utf-8"))
    parse_result = payload.get("parse_result") if isinstance(payload, dict) else None
    if not isinstance(parse_result, dict):
        return None
    return {
        "model": (parse_result.get("page_diagnostics") or {}).get("vlm_response_resolved_model"),
        "phase_ms": parse_result.get("phase_ms"),
        "prompt_chars": parse_result.get("prompt_chars"),
    }


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    api_key = os.environ.get(args.api_key_env, "").strip()
    if not api_key:
        print(f"{args.api_key_env} is required", file=sys.stderr)
        return 2

    try:
        logs = decode_request_logs(read_mmkv(args))
        entry = select_request(logs, args.model)
        request = json.loads(str(entry["requestJson"]))
        if not isinstance(request, dict):
            raise RuntimeError("Saved request JSON is not an object")
        request["stream"] = True
        request_bytes = json.dumps(request, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        url = str(entry.get("url") or "").strip()
        parsed_url = urlsplit(url)
        if parsed_url.scheme != "https" or not parsed_url.hostname:
            raise RuntimeError("Saved request URL must be HTTPS")
        profile, return_code, stderr = profile_request(
            url=url,
            api_key=api_key,
            request_bytes=request_bytes,
            timeout=args.timeout,
        )
        http_code = int(profile["network"].get("http_code") or 0)
        result = {
            "schema_version": "oob.vlm_single_stream_profile.v1",
            "source": {
                "device": args.device,
                "saved_at_ms": entry.get("createdAt"),
                "provider_host": parsed_url.hostname,
                "model": entry.get("model"),
                "same_payload_replay": True,
            },
            "request": request_shape(request, request_bytes),
            "app_observed": load_app_result(args.app_result),
            **profile,
            "success": return_code == 0 and 200 <= http_code < 300,
            "curl_exit_code": return_code,
            "error": stderr if return_code != 0 else None,
        }
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        return 1

    rendered = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
    print(rendered, end="")
    return 0 if result["success"] else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
