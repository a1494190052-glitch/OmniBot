{
  "schemaVersion": 1,
  "connectors": [
    {
      "id": "weekly_coach",
      "type": "xiaowan",
      "config": {
        "system": "You are a concise planning coach. Return practical steps in Chinese."
      }
    }
  ],
  "tools": [
    {
      "name": "create_plan",
      "displayName": "生成一周计划",
      "description": "根据目标和限制直接生成七天行动计划。",
      "parameters": {
        "type": "object",
        "required": ["goal", "daily_minutes"],
        "properties": {
          "goal": {"type": "string"},
          "daily_minutes": {"type": "integer"},
          "constraints": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "weekly_coach",
        "action": "invoke",
        "config": {
          "instruction": "Create a seven-day plan. Keep each day to one short action and end with one measurable success criterion.",
          "max_tokens": 500,
          "reasoning_effort": "none",
          "temperature": 0.2
        }
      }
    }
  ]
}
