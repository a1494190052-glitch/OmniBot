{
  "schemaVersion": 1,
  "connectors": [
    {
      "id": "career_store",
      "type": "sqlite",
      "config": {}
    },
    {
      "id": "career_coach",
      "type": "xiaowan",
      "config": {
        "system": "You are a concise fictional basketball career coach. Use only supplied player and game facts. Never claim a simulated result is real. Reply in Chinese."
      }
    }
  ],
  "tools": [
    {
      "name": "create_player",
      "displayName": "创建篮球球员",
      "description": "创建并持久化一个虚构篮球生涯球员。",
      "parameters": {
        "type": "object",
        "required": ["name", "position", "archetype", "overall", "fans"],
        "properties": {
          "name": {"type": "string"},
          "position": {"type": "string"},
          "archetype": {"type": "string"},
          "overall": {"type": "integer"},
          "fans": {"type": "integer"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "insert",
        "config": {"table": "players"}
      }
    },
    {
      "name": "list_players",
      "displayName": "查询篮球球员",
      "description": "查询已持久化的虚构篮球生涯球员。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "_limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "_order_by": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "query",
        "config": {"table": "players"}
      }
    },
    {
      "name": "update_player",
      "displayName": "更新篮球球员",
      "description": "更新一个已存在球员的可变生涯数据。",
      "parameters": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "integer"},
          "overall": {"type": "integer"},
          "fans": {"type": "integer"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "update",
        "config": {"table": "players"}
      }
    },
    {
      "name": "record_game",
      "displayName": "记录生涯比赛",
      "description": "持久化一场明确标记为虚构模拟的篮球比赛。",
      "parameters": {
        "type": "object",
        "required": ["player_id", "season", "game_number", "opponent", "result", "points", "rebounds", "assists", "grade", "story"],
        "properties": {
          "player_id": {"type": "integer"},
          "season": {"type": "integer"},
          "game_number": {"type": "integer"},
          "opponent": {"type": "string"},
          "result": {"type": "string"},
          "points": {"type": "integer"},
          "rebounds": {"type": "integer"},
          "assists": {"type": "integer"},
          "grade": {"type": "number"},
          "story": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "insert",
        "config": {"table": "games"}
      }
    },
    {
      "name": "list_games",
      "displayName": "查询生涯比赛",
      "description": "查询某位球员已保存的虚构比赛记录。",
      "parameters": {
        "type": "object",
        "properties": {
          "player_id": {"type": "integer"},
          "season": {"type": "integer"},
          "_limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "_order_by": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "query",
        "config": {"table": "games"}
      }
    },
    {
      "name": "record_note",
      "displayName": "保存生涯建议",
      "description": "保存一条已经生成并展示给用户的虚构生涯建议。",
      "parameters": {
        "type": "object",
        "required": ["player_id", "content", "model"],
        "properties": {
          "player_id": {"type": "integer"},
          "content": {"type": "string"},
          "model": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "insert",
        "config": {"table": "career_notes"}
      }
    },
    {
      "name": "list_notes",
      "displayName": "查询生涯建议",
      "description": "查询某位球员已经保存的虚构生涯建议。",
      "parameters": {
        "type": "object",
        "properties": {
          "player_id": {"type": "integer"},
          "_limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "_order_by": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_store",
        "action": "query",
        "config": {"table": "career_notes"}
      }
    },
    {
      "name": "career_advice",
      "displayName": "生成生涯建议",
      "description": "根据明确提供的球员资料和比赛摘要生成虚构篮球生涯建议。",
      "parameters": {
        "type": "object",
        "required": ["player", "recent_games"],
        "properties": {
          "player": {"type": "string"},
          "recent_games": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "career_coach",
        "action": "invoke",
        "config": {
          "instruction": "Give three short development priorities and one next-game challenge. Explicitly call this fictional career coaching.",
          "reasoning_effort": "none",
          "max_tokens": 500,
          "temperature": 0.5
        }
      }
    }
  ]
}
