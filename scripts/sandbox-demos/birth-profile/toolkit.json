{
  "schemaVersion": 1,
  "connectors": [
    {
      "id": "profile_store",
      "type": "sqlite",
      "config": {}
    },
    {
      "id": "profile_reader",
      "type": "xiaowan",
      "config": {
        "system": "Give a short, non-deterministic cultural interpretation in Chinese. Do not present it as scientific or medical fact."
      }
    }
  ],
  "tools": [
    {
      "name": "save_profile",
      "displayName": "保存出生信息",
      "description": "直接保存一份出生信息。",
      "parameters": {
        "type": "object",
        "required": ["person_name", "birth_date", "birth_time", "birth_place"],
        "properties": {
          "person_name": {"type": "string"},
          "birth_date": {"type": "string"},
          "birth_time": {"type": "string"},
          "birth_place": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "profile_store",
        "action": "insert",
        "config": {"table": "birth_profiles"}
      }
    },
    {
      "name": "list_profiles",
      "displayName": "查询出生信息",
      "description": "直接查询已保存的出生信息。",
      "parameters": {
        "type": "object",
        "properties": {
          "person_name": {"type": "string"},
          "_limit": {"type": "integer", "minimum": 1, "maximum": 500}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "profile_store",
        "action": "query",
        "config": {"table": "birth_profiles"}
      }
    },
    {
      "name": "interpret_profile",
      "displayName": "解读出生信息",
      "description": "根据明确提供的出生信息生成简短文化解读。",
      "parameters": {
        "type": "object",
        "required": ["person_name", "birth_date", "birth_time", "birth_place"],
        "properties": {
          "person_name": {"type": "string"},
          "birth_date": {"type": "string"},
          "birth_time": {"type": "string"},
          "birth_place": {"type": "string"}
        },
        "additionalProperties": false
      },
      "executor": {
        "connector": "profile_reader",
        "action": "invoke",
        "config": {
          "instruction": "Explain the supplied birth profile in at most four short bullet points, then add one sentence saying it is for cultural entertainment only.",
          "max_tokens": 400,
          "reasoning_effort": "none",
          "temperature": 0.2
        }
      }
    }
  ]
}
