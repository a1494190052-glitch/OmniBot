{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "oob.omniflow.android_bridge",
  "contract_version": 2,
  "protocol_version": "omniflow.bridge.v2",
  "transport": {
    "encoding": "utf-8",
    "framing": "json-lines",
    "request": {
      "required": ["id", "op"],
      "optional": ["payload"]
    },
    "response": {
      "required": ["id", "ok", "result", "error"],
      "success": {"ok": true, "error": null},
      "failure": {"ok": false, "result": null}
    }
  },
  "function": {
    "identifier_field": "function_id",
    "schema_version": "omniflow.function.v2",
    "accepted_input_aliases": [],
    "forbidden_output_fields": ["id", "parameters", "actions", "execution"]
  },
  "state": {
    "identifier_field": "state_id",
    "inline_xml_field": "xml",
    "display_field": "display",
    "display_semantics": "device_screen_pixels",
    "accepted_input_aliases": []
  },
  "operations": {
    "catalog": {
      "request": {
        "action": [
          "list",
          "get",
          "put",
          "delete",
          "clear"
        ]
      },
      "response": {
        "function_values_use": "function_id"
      }
    },
    "compile": {
      "request": {
        "required": ["run_id"],
        "optional": [
          "register",
          "agent_visible",
          "function_id",
          "name",
          "description",
          "enhance"
        ]
      },
      "host_calls": ["get_run_log", "complete_json"],
      "response": {
        "required": [
          "success",
          "status",
          "run_id",
          "function_id",
          "function",
          "registered",
          "enhancement_status",
          "changes",
          "error"
        ]
      }
    },
    "update_function": {
      "request": {
        "required": ["function_id"],
        "optional": ["mode", "patch", "dry_run", "run_id"]
      },
      "host_calls": ["get_run_log", "complete_json"],
      "response": {
        "required": [
          "success",
          "function_id",
          "function",
          "updated_function",
          "changed",
          "saved"
        ]
      }
    },
    "enhance": {
      "request": {"required": ["function_id"], "optional": ["run_log"]},
      "host_calls": ["complete_json"],
      "response": {
        "required": [
          "success",
          "function_id",
          "found",
          "function",
          "updated_function",
          "changed",
          "saved",
          "changes",
          "enhancement_status"
        ]
      }
    },
    "control_act": {
      "request": {
        "required": ["action"],
        "optional": ["function_id", "source_state_id", "checker_rules", "state"]
      },
      "host_calls": ["observe", "act", "get_state", "record_step"],
      "response": {
        "required": [
          "success",
          "action",
          "result",
          "before_state",
          "after_state",
          "error"
        ],
        "optional": ["transfer"]
      }
    },
    "health": {
      "request": {"required": []},
      "response": {
        "required": [
          "protocol_version",
          "capabilities",
          "contract_sha256",
          "runtime_version",
          "omniflow_commit",
          "omniflow_source_sha256",
          "omnitransfer_commit",
          "omnitransfer_source_sha256"
        ]
      }
    },
    "prepare_action": {
      "request": {"required": ["function_id", "source_state_id", "action", "state"]},
      "host_calls": ["get_state"],
      "response": {
        "required": [
          "success",
          "decision",
          "action",
          "reason"
        ],
        "optional": ["transfer"]
      }
    },
    "recall": {
      "request": {"required": ["goal", "state"], "optional": ["limit"]},
      "response": {
        "required": [
          "success",
          "retrieval_state",
          "candidates",
          "count",
          "reason",
          "runtime_source",
          "duration_ms"
        ],
        "candidate": {
          "required": ["function", "retrieval"],
          "function_schema_ref": "omniflow_function.v2.json",
          "retrieval": {
            "required": ["score", "source", "rank"],
            "score_range": [0.0, 1.0]
          }
        }
      }
    },
    "run": {
      "request": {
        "one_of": ["function_id", "goal"],
        "optional": [
          "arguments",
          "run_id",
          "execution_mode",
          "started_at_ms",
          "model",
          "resolver_model",
          "max_steps",
          "target_package_name",
          "step_skill_guidance",
          "disable_function_recall"
        ]
      },
      "host_calls": [
        "observe",
        "act",
        "get_state",
        "record_step",
        "model_turn",
        "complete_json",
        "request_input"
      ],
      "response": {
        "required": [
          "success",
          "status",
          "run_id",
          "function_id",
          "source",
          "runner",
          "execution_mode",
          "step_count",
          "success_step_count",
          "completed_step_count",
          "actions_executed",
          "steps",
          "started_at_ms",
          "finished_at_ms",
          "duration_ms"
        ],
        "optional": [
          "name",
          "description",
          "failed_step_index",
          "current_step_index",
          "current_step_number",
          "error_code",
          "error_message",
          "missing_required_arguments",
          "final_state",
          "done_reason",
          "finished_content",
          "model",
          "model_calls",
          "fallback_steps"
        ]
      }
    },
    "shutdown": {
      "request": {"required": []},
      "response": {"required": ["stopped"]}
    }
  },
  "host_call": {
    "request_required": ["id", "event", "call_id", "method", "payload"],
    "response_required": ["call_id", "ok", "result", "error"],
    "methods": [
      "act",
      "complete_json",
      "get_run_log",
      "get_state",
      "model_turn",
      "observe",
      "record_step",
      "request_input"
    ],
    "act_payload": {"required": ["action", "state"], "optional": ["metadata"]},
    "model_turn_payload": {
      "required": ["goal", "model", "state", "max_steps"],
      "optional": ["target_package_name", "step_skill_guidance"]
    },
    "request_input_payload": {"required": ["question"]},
    "record_step_payload": {
      "required": ["step"],
      "step_schema_ref": "omniflow_canonical_run_log.v1.json#/$defs/step"
    }
  },
  "invariants": {
    "closed_operation_set": true,
    "function_output_identifier": "function_id",
    "action_coordinate_space": "relative_0_1000",
    "state_display_semantics": "device_screen_pixels",
    "android_pixel_conversion_owner": "host_action_executor",
    "control_act_transfer_failure": {
      "success": false,
      "action": null,
      "forbid_source_coordinate_passthrough": true
    }
  }
}
