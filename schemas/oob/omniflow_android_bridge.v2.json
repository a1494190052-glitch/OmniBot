{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "oob.omniflow.android_bridge",
  "contract_version": 2,
  "protocol_version": "omniflow.bridge.v2",
  "transport": {
    "encoding": "utf-8",
    "framing": "json-lines",
    "request": {
      "required": ["id", "op"],
      "optional": ["payload"]
    },
    "response": {
      "required": ["id", "ok", "result", "error"],
      "success": {"ok": true, "error": null},
      "failure": {"ok": false, "result": null}
    }
  },
  "function": {
    "identifier_field": "function_id",
    "schema_version": "omniflow.function.v2",
    "accepted_input_aliases": [],
    "forbidden_output_fields": ["id", "parameters", "actions", "execution"]
  },
  "state": {
    "identifier_field": "state_id",
    "inline_xml_field": "xml",
    "display_field": "display",
    "display_semantics": "device_screen_pixels",
    "accepted_input_aliases": []
  },
  "operations": {
    "function_tool": {
      "request": {
        "required": ["tool"],
        "optional": ["args"],
        "tools": [
          "function.recall",
          "oob_function_list",
          "oob_function_get",
          "oob_function_register",
          "update_function",
          "oob_function_delete",
          "oob_function_clear",
          "oob_run_log_list",
          "oob_run_log_get",
          "oob_run_log_convert"
        ]
      },
      "host_calls": [
        "list_run_logs",
        "get_run_log",
        "get_state",
        "observe",
        "complete_json",
        "schedule_operation",
        "update_run_log_diagnostics"
      ],
      "response": {
        "semantics": "The selected Function tool returns its canonical payload without Kotlin reshaping.",
        "function_identifier": "function_id"
      }
    },
    "health": {
      "request": {"required": []},
      "response": {
        "required": [
          "protocol_version",
          "capabilities",
          "contract_sha256",
          "runtime_version",
          "omniflow_commit",
          "omniflow_source_sha256",
          "omnitransfer_commit",
          "omnitransfer_source_sha256"
        ]
      }
    },
    "run": {
      "request": {
        "one_of": ["function_id", "goal"],
        "optional": [
          "arguments",
          "run_id",
          "execution_mode",
          "started_at_ms",
          "model",
          "resolver_model",
          "max_steps",
          "target_package_name",
          "step_skill_guidance",
          "disable_function_recall",
          "defer_user_input"
        ]
      },
      "host_calls": [
        "installed_apps",
        "observe",
        "act",
        "get_state",
        "record_step",
        "model_turn",
        "complete_json",
        "request_input"
      ],
      "response": {
        "required": [
          "success",
          "status",
          "run_id",
          "function_id",
          "source",
          "runner",
          "execution_mode",
          "step_count",
          "success_step_count",
          "completed_step_count",
          "actions_executed",
          "steps",
          "started_at_ms",
          "finished_at_ms",
          "duration_ms"
        ],
        "optional": [
          "name",
          "description",
          "failed_step_index",
          "current_step_index",
          "current_step_number",
          "error_code",
          "error_message",
          "missing_required_arguments",
          "final_state",
          "done_reason",
          "finished_content",
          "model",
          "model_calls",
          "fallback_steps"
        ]
      }
    },
    "shutdown": {
      "request": {"required": []},
      "response": {"required": ["stopped"]}
    }
  },
  "host_call": {
    "request_required": ["id", "event", "call_id", "method", "payload"],
    "response_required": ["call_id", "ok", "result", "error"],
    "methods": [
      "act",
      "complete_json",
      "get_run_log",
      "get_state",
      "installed_apps",
      "list_run_logs",
      "model_turn",
      "observe",
      "record_step",
      "request_input",
      "schedule_operation",
      "update_run_log_diagnostics"
    ],
    "act_payload": {"required": ["action", "state"], "optional": ["metadata"]},
    "installed_apps_payload": {"required": []},
    "installed_apps_response": {"required": ["apps"]},
    "model_turn_payload": {
      "required": ["goal", "model", "state", "max_steps", "request"],
      "optional": ["target_package_name", "step_skill_guidance"]
    },
    "model_turn_response": {
      "required": ["requested_model", "tool_calls"],
      "optional": ["resolved_model", "reasoning", "finish_reason", "usage"]
    },
    "request_input_payload": {"required": ["question"]},
    "list_run_logs_payload": {
      "required": ["limit", "offset", "source", "status", "model", "query"]
    },
    "schedule_operation_payload": {
      "required": ["operation", "payload"],
      "operation": ["function_tool"]
    },
    "schedule_operation_response": {"required": ["accepted"]},
    "update_run_log_diagnostics_payload": {
      "required": ["run_id", "diagnostics"]
    },
    "update_run_log_diagnostics_response": {"required": ["updated"]},
    "record_step_payload": {
      "required": ["fact"],
      "fact": {
        "required": [
          "before_state_id",
          "action",
          "result",
          "after_state_id"
        ],
        "optional": ["metadata"],
        "result_schema_ref": "omniflow_canonical_run_log.v1.json#/$defs/result",
        "action_schema_ref": "oob_canonical_actions.v1.json"
      }
    },
    "record_step_response": {
      "required": ["step"],
      "step_schema_ref": "omniflow_canonical_run_log.v1.json#/$defs/step"
    }
  },
  "invariants": {
    "closed_operation_set": true,
    "function_output_identifier": "function_id",
    "action_coordinate_space": "relative_0_1000",
    "state_display_semantics": "device_screen_pixels",
    "vlm_tool_coordinate_space": "current_display_pixels",
    "vlm_coordinate_conversion_owner": "omniflow.vlm_coordinates",
    "manual_coordinate_conversion_owner": "canonicalManualScreenAction",
    "android_pixel_conversion_owner": "host_action_executor",
    "function_transfer_failure_falls_back_to_vlm": true
  }
}
