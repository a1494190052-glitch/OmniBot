{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/oob/omniflow_checker_rule.v1.json",
  "title": "OmniFlow Checker Rule",
  "description": "Shared checker rule contract for Function metadata.checker_rules and workspace checkers/checker_rules.json. Native replay evaluates generic XML/XPath, package, and keyboard conditions before action transfer.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "condition", "action"],
  "properties": {
    "schema_version": {
      "const": "omniflow.checker_rule.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/condition"},
        {"$ref": "#/$defs/condition_name"}
      ]
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/action"},
        {"$ref": "#/$defs/action_name"}
      ]
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "priority": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": ["builtin", "function_metadata", "step_metadata", "update_function", "trigger_pool", "runtime_policy"]
    },
    "params": {
      "type": "object",
      "description": "Legacy flat-rule parameters. New rules should prefer condition/action/budget fields."
    }
  },
  "$defs": {
    "phase": {
      "type": "string",
      "enum": ["pre_transfer", "pre_action", "post_action"]
    },
    "condition_name": {
      "type": "string",
      "enum": [
        "xpath_exists",
        "target_covered_by_xpath",
        "keyboard_obscuring",
        "package_mismatch"
      ]
    },
    "action_name": {
      "type": "string",
      "enum": [
        "click",
        "hide_keyboard",
        "open_app",
        "wait"
      ]
    },
    "string_list": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "function_ids": {"$ref": "#/$defs/string_list"},
        "step_indexes": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "action_types": {"$ref": "#/$defs/string_list"},
        "package_names": {"$ref": "#/$defs/string_list"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/condition_name"},
        "xpath_exists": {"type": "string", "minLength": 1},
        "xpath": {"type": "string", "minLength": 1},
        "target_covered_by_xpath": {"type": "string", "minLength": 1},
        "keyboard_obscuring": {"type": "boolean"},
        "keyboard_obscures_target": {"type": "boolean"},
        "package_mismatch": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/action_name"},
        "action": {"$ref": "#/$defs/action_name"},
        "target_xpath": {"type": "string", "minLength": 1},
        "package_name": {"type": "string", "minLength": 1},
        "wait_ms": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_triggers_per_run": {"type": "integer", "minimum": 0},
        "max_triggers_per_step": {"type": "integer", "minimum": 0},
        "cooldown_ms": {"type": "integer", "minimum": 0}
      }
    }
  },
  "examples": [
    {
      "schema_version": "omniflow.checker_rule.v1",
      "id": "dismiss_optional_overlay_by_xpath",
      "enabled": true,
      "phase": "pre_transfer",
      "condition": {
        "xpath_exists": "//node[@clickable='true' and contains(@text,'关闭')]"
      },
      "action": {
        "action": "click",
        "target_xpath": "//node[@clickable='true' and contains(@text,'关闭')]"
      },
      "budget": {
        "max_triggers_per_run": 2,
        "max_triggers_per_step": 1
      },
      "priority": 100,
      "source": "function_metadata"
    }
  ]
}
