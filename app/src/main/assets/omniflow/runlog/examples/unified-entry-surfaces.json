{
  "schema_version": "oob.omniflow_entry_surface_contract.v1",
  "purpose": "Machine-readable contract for keeping UI, MCP, HTTP/debug, VLM recall, and Python OmniFlow on one OOB-native Function execution path.",
  "runtime_owner": "oob_native_kotlin",
  "native_facade": "OobOmniFlowToolkitService",
  "phone_action_runner": "OobFunctionToolHandler",
  "enhancement_policy": "offline_only",
  "product_label": {
    "zh": "复用指令",
    "en": "Reusable command",
    "compatibility_aliases": [
      "复用记忆"
    ]
  },
  "entry_surfaces": [
    {
      "id": "ui_agent_function_run",
      "surface": "flutter_method_channel",
      "adapter": "AssistsMessageService.runOobReusableFunctionWithAgent -> createAgentTask",
      "input_shape": "function_id_plus_public_arguments",
      "delegates_to": [
        "Agent profile omniflow",
        "oob_function_run"
      ],
      "may_execute_phone_actions": true,
      "phone_action_owner": "agent_profile_then_kotlin_action_executor",
      "requires_concrete_function_id": true,
      "model_visible_function_execution_tool": true,
      "tool_profile": "omniflow",
      "allowed_tools": [
        "oob_function_run"
      ],
      "arguments_field_policy": "nested_arguments_preserved",
      "mutates_saved_function": false,
      "enhance_inline_allowed": false
    },
    {
      "id": "ui_direct_function_run_adapter",
      "surface": "flutter_method_channel",
      "adapter": "AssistsCoreManager.runOobReusableFunction",
      "input_shape": "function_id_plus_public_arguments",
      "delegates_to": [
        "OobOmniFlowToolkitService.runFunction"
      ],
      "may_execute_phone_actions": true,
      "phone_action_owner": "kotlin_only",
      "requires_concrete_function_id": true,
      "model_visible_function_execution_tool": false,
      "arguments_field_policy": "nested_arguments_preserved",
      "debug_or_compat_only": false,
      "ordinary_product_ui_should_call": "ui_direct_function_run_adapter",
      "mutates_saved_function": false,
      "enhance_inline_allowed": false
    },
    {
      "id": "ui_update_function",
      "surface": "flutter_method_channel",
      "adapter": "AssistsCoreManager.updateOobFunction",
      "input_shape": "function_id_runlog_evidence_analysis_patch",
      "delegates_to": [
        "OobOmniFlowToolkitService.executeTool(update_function)"
      ],
      "may_execute_phone_actions": false,
      "phone_action_owner": "none",
      "requires_concrete_function_id": true,
      "model_visible_function_execution_tool": false,
      "mutates_saved_function": true,
      "enhance_inline_allowed": false,
      "enhance_policy": "offline_background_only"
    },
    {
      "id": "mcp_function_lifecycle_tools",
      "surface": "mcp_tools",
      "adapter": "McpRoutes.executeTool",
      "input_shape": "omniflow_lifecycle_tool_payload",
      "allowed_tools": [
        "omniflow.recall",
        "omniflow.ingest_run_log",
        "omniflow.explore_replay",
        "oob_function_list",
        "oob_function_get",
        "oob_function_register",
        "update_function",
        "oob_function_delete",
        "oob_function_clear",
        "oob_run_log_list",
        "oob_run_log_get",
        "oob_run_log_convert"
      ],
      "delegates_to": [
        "OobOmniFlowToolkitService.executeTool"
      ],
      "runlog_policy": "runlog_is_evidence; explore_replay_must_convert_then_execute_function",
      "may_execute_phone_actions": true,
      "phone_action_owner": "kotlin_only_after_native_dispatch",
      "requires_concrete_function_id": "tool_specific",
      "model_visible_function_execution_tool": false,
      "forbidden_public_tools": [
        "call_tool",
        "run_function",
        "oob_function_run",
        "omniflow.call_function",
        "omniflow.run_function",
        "omniflow.execute_function",
        "oob_run_log_replay",
        "runlog_replay"
      ],
      "enhance_inline_allowed": false
    },
    {
      "id": "http_function_run",
      "surface": "debug_http",
      "adapter": "LocalDeviceHttpHostManager.post(/omniflow/function/run)",
      "input_shape": "function_id_plus_public_arguments",
      "delegates_to": [
        "OobOmniFlowToolkitService.executeTool(run_function)"
      ],
      "may_execute_phone_actions": true,
      "phone_action_owner": "kotlin_only",
      "requires_concrete_function_id": true,
      "model_visible_function_execution_tool": false,
      "arguments_field_policy": "nested_arguments_preserved",
      "debug_or_dev_only": true,
      "enhance_inline_allowed": false
    },
    {
      "id": "python_omniflow_offline",
      "surface": "built_in_alpine_python",
      "adapter": "omniflow-provider / omniflow-mcp",
      "input_shape": "exported_runlogs_functions_fixtures",
      "delegates_to": [
        "schema_validation",
        "offline_fixture_eval",
        "omniflow.recall",
        "omniflow.ingest_run_log",
        "omniflow.update_function"
      ],
      "may_execute_phone_actions": false,
      "phone_action_owner": "none",
      "requires_concrete_function_id": false,
      "model_visible_function_execution_tool": false,
      "must_call_oob_adapter_for_phone_execution": true,
      "enhance_policy": "offline_patches_only"
    }
  ],
  "invariants": {
    "single_live_phone_executor": "All phone actions eventually enter the OOB-native facade and Kotlin runner.",
    "direct_function_calls_require_id": true,
    "ordinary_vlm_prompt_has_no_function_id_execution_tool": true,
    "enhance_never_blocks_registration_recall_or_replay": true,
    "python_never_owns_accessibility_or_overlay": true,
    "ui_never_interprets_function_steps_in_dart": true
  },
  "required_device_gates": [
    "scripts/oob-mainline-acceptance.sh --device <serial>",
    "scripts/oob-manual-recording-function-smoke.sh --device <serial>",
    "scripts/oob-vlm-recall-loop-smoke.sh --device <serial> --output-dir runtime/vlm-recall-loop/<case>"
  ],
  "offline_gates": [
    "scripts/oob-mainline-acceptance.sh --skip-device",
    "scripts/oob-omniflow-python-offline-contract-smoke.py",
    "scripts/oob-vlm-accuracy-report.py --smoke-dir <captured-smoke-dir> --strict"
  ]
}
