#!/bin/sh
# tg-gateway — One-command launcher for Omnibot Telegram Gateway
# Note: Uses terminal sessions for persistence in proot Alpine.
#       Background processes (& nohup) die when terminal exits.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SKILL_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
PID_FILE="/tmp/tg-gateway.pid"
LOG_FILE="/tmp/tg-gateway.log"
STOP_FLAG="/tmp/tg-gateway-stop"
SESSION_FILE="/tmp/tg-gateway-session"

cd "$SKILL_DIR" || exit 1

case "${1:-start}" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "✅ Already running (PID $(cat "$PID_FILE"))"
      exit 0
    fi
    rm -f "$STOP_FLAG"
    VENV_PY="$SKILL_DIR/.venv/bin/python"
    [ -x "$VENV_PY" ] || VENV_PY="python3"
    # Use nohup + disown for best-effort persistence
    nohup "$VENV_PY" scripts/gateway.py >> "$LOG_FILE" 2>&1 &
    disown
    echo $! > "$PID_FILE"
    sleep 3
    if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "✅ Running (PID $(cat "$PID_FILE"))"
    else
      echo "⚠️  Process exited (normal in proot). Use Omnibot to start via terminal session."
      echo "   Say: start telegram gateway"
      rm -f "$PID_FILE"
      exit 1
    fi
    ;;
  stop)
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        echo "⏹️  Stopping (PID $PID)..."
        kill "$PID" 2>/dev/null
        sleep 2
        kill -9 "$PID" 2>/dev/null
      fi
      rm -f "$PID_FILE"
    fi
    touch "$STOP_FLAG"
    echo "✅ Stopped."
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "✅ Running (PID $(cat "$PID_FILE"))"
      tail -3 "$LOG_FILE" 2>/dev/null
    else
      echo "❌ Not running via launcher."
      echo "   Say: start telegram gateway"
    fi
    ;;
  test)
    "$SKILL_DIR/.venv/bin/python" scripts/tgctl.py test
    ;;
  logs)
    tail -f "$LOG_FILE" 2>/dev/null || echo "No logs yet."
    ;;
  setup)
    "$SKILL_DIR/.venv/bin/python" scripts/tgctl.py setup
    ;;
  *)
    echo "Usage: tg-gateway [start|stop|restart|status|test|logs|setup]"
    exit 1
    ;;
esac
